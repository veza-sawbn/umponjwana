# Visit Drakensberg — required environment variables
# Copy to .env.local for development. In production these are set on Vercel.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL (no trailing slash) — used for SEO metadata & sitemap
NEXT_PUBLIC_SITE_URL=https://visitdrakensberg.com

# Optional: legacy FastAPI backend proxied via /api/backend (admin analytics)
NEXT_PUBLIC_API_URL=

# Optional: Upstash-compatible Redis REST endpoint for caching
REDIS_URL=

# Optional: Google Maps (distance calculations for shuttle quotes)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase service role key — server-only, never expose to the browser.
# Used by API routes (invoice payments, receipt emails) that must run with
# no customer session, e.g. the iKhokha webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email delivery via SMTP through the mailbox hosted at
# domains.co.za (skipped gracefully if unset — see lib/mailer.ts). Powers
# receipts, quotes, and every in-app notification (bookings, cancellations,
# supplier approvals, messages) sent through lib/notifications.ts.
# SMTP_HOST is a bare hostname — mail.example.com, NOT https://mail.example.com.
SMTP_HOST=mail.example.com
SMTP_PORT=465
# Leave SMTP_SECURE BLANK. It is not a setting your mail host provides — it
# describes the encryption, which follows from the port (465 = implicit TLS,
# 587/25 = STARTTLS) and is inferred automatically. Set it only to override an
# unusual server.
SMTP_SECURE=
# Usually the FULL email address, not the bare mailbox name — a username like
# "noreply" instead of "noreply@example.com" is the most common cause of a
# "535 Incorrect authentication data" rejection.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Visit Drakensberg <noreply@visitdrakensberg.com>"

# iKhokha "iK Pay API" — online invoice payments (Settings → Payments → iK Pay
# API in the iKhokha Merchant Dashboard). Without these, invoices show "online
# payment is not set up yet" instead of a Pay Now button.
IKHOKHA_APP_ID=
IKHOKHA_APP_KEY=
IKHOKHA_MODE=test
# Optional — only set if your dashboard shows different values from IKHOKHA_APP_ID
IKHOKHA_ENTITY_ID=
IKHOKHA_EXTERNAL_ENTITY_ID=

# Optional but recommended: guards /api/cron/expire-pending-bookings so only
# Vercel's own Cron Jobs can trigger it. Set any random string here — Vercel
# automatically sends it as `Authorization: Bearer <value>` on cron requests
# once this var exists on the project. Note: vercel.json schedules this once
# daily because Vercel's free Hobby tier REJECTS THE WHOLE DEPLOYMENT if any
# cron runs more often than that — Pro (or an external scheduler hitting
# this route on a tighter schedule) is needed for expiry to happen sooner
# than "up to a day" after a booking is abandoned.
CRON_SECRET=

# Emergency admin account recovery (POST /api/admin/recover-admin).
# Set to a strong random string (≥32 chars) when you need to reset the admin
# account password without an existing admin session (e.g. after a broken
# password-reset flow locks out the admin). Send:
#   Authorization: Bearer <value>  +  {"email":"...", "password":"..."}
# Rotate or remove this value immediately after the admin account is recovered.
ADMIN_RECOVERY_SECRET=
