# Visit Drakensberg — required environment variables
# Copy to .env.local for development. In production these are set on Vercel.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL — NO trailing slash, MUST include https:// scheme.
# Example: https://umponjwana.vercel.app  (NOT umponjwana.vercel.app)
# Used for: SEO metadata, sitemap, and as THE source of the host in every
# server-built email link. An x-forwarded-host header is honoured only when it
# names this host (or one of TRUSTED_SITE_HOSTS below) — anything else is
# ignored and this value is used instead, because several of those links carry
# a credential and a request header must never choose where it is delivered.
#
# IMPORTANT — Supabase redirect URL allowlist (Auth → URL Configuration):
#   Add BOTH of these patterns with a wildcard for preview deploys:
#     https://umponjwana.vercel.app/auth/reset-password
#     https://umponjwana.vercel.app/api/auth/callback
#     https://*.vercel.app/auth/reset-password     ← for preview branches
#     https://*.vercel.app/api/auth/callback       ← for preview branches
#   Without /api/auth/callback in the list, password reset emails will fail
#   with "Redirect URL not allowed" from Supabase.
NEXT_PUBLIC_SITE_URL=https://visitdrakensberg.com

# Optional: additional hosts allowed to appear in server-built email links,
# comma-separated (a second public domain, a staging host). Vercel preview
# deploys are already covered when NEXT_PUBLIC_SITE_URL is a *.vercel.app host.
# Anything not listed here or in NEXT_PUBLIC_SITE_URL is ignored if it arrives
# as x-forwarded-host.
TRUSTED_SITE_HOSTS=

# Optional: legacy FastAPI backend proxied via /api/backend (admin analytics)
NEXT_PUBLIC_API_URL=

# Upstash-compatible Redis REST endpoint. STRONGLY RECOMMENDED in production:
# without it, rate limiting (password reset, admin recovery, invoice PDFs,
# notification emails, payment-link creation — see lib/rate-limit.ts) falls
# back to a per-instance in-memory counter, which bounds one serverless
# instance rather than the platform. Both variables are required: REDIS_TOKEN
# was missing from the frontend client until the September 2026 audit, so
# every call was rejected and silently swallowed.
REDIS_URL=
REDIS_TOKEN=

# Optional: Google Maps (distance calculations for shuttle quotes)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Mapbox (Route Profile "Map View" on /hikes/[id] — an interactive
# Mapbox GL map with the GPX route drawn on it; falls back to a schematic
# line trace if unset). The default public token from your account works —
# no extra scopes needed: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: your own Mapbox Studio style for the same map (falls back to
# Mapbox's default outdoors style if unset). Get this from Mapbox Studio →
# your style → Share → Style URL. Format: mapbox://styles/{username}/{style_id}
NEXT_PUBLIC_MAPBOX_STYLE_URL=

# Supabase service role key — server-only, never expose to the browser.
# Used by API routes (invoice payments, receipt emails) that must run with
# no customer session, e.g. the iKhokha webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email delivery via SMTP through the mailbox hosted at
# domains.co.za (skipped gracefully if unset — see lib/mailer.ts). Powers
# receipts, quotes, and every in-app notification (bookings, cancellations,
# supplier approvals, messages) sent through lib/notifications.ts.
# SMTP_HOST is a bare hostname — mail.example.com, NOT https://mail.example.com.
SMTP_HOST=mail.example.com
SMTP_PORT=465
# Leave SMTP_SECURE BLANK. It is not a setting your mail host provides — it
# describes the encryption, which follows from the port (465 = implicit TLS,
# 587/25 = STARTTLS) and is inferred automatically. Set it only to override an
# unusual server.
SMTP_SECURE=
# Usually the FULL email address, not the bare mailbox name — a username like
# "noreply" instead of "noreply@example.com" is the most common cause of a
# "535 Incorrect authentication data" rejection.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Visit Drakensberg <noreply@visitdrakensberg.com>"

# iKhokha "iK Pay API" — online invoice payments (Settings → Payments → iK Pay
# API in the iKhokha Merchant Dashboard). Without these, invoices show "online
# payment is not set up yet" instead of a Pay Now button.
IKHOKHA_APP_ID=
IKHOKHA_APP_KEY=
IKHOKHA_MODE=test
# Optional — only set if your dashboard shows different values from IKHOKHA_APP_ID
IKHOKHA_ENTITY_ID=
IKHOKHA_EXTERNAL_ENTITY_ID=

# Optional but recommended: guards /api/cron/expire-pending-bookings so only
# Vercel's own Cron Jobs can trigger it. Set any random string here — Vercel
# automatically sends it as `Authorization: Bearer <value>` on cron requests
# once this var exists on the project. Note: vercel.json schedules this once
# daily because Vercel's free Hobby tier REJECTS THE WHOLE DEPLOYMENT if any
# cron runs more often than that — Pro (or an external scheduler hitting
# this route on a tighter schedule) is needed for expiry to happen sooner
# than "up to a day" after a booking is abandoned.
CRON_SECRET=

# Optional but strongly recommended: where operational alerts go. Any endpoint
# that accepts a JSON POST — a Slack incoming webhook, a Discord webhook,
# PagerDuty Events v2, or your own. Unset, alerts still appear in the
# structured log (lib/observability.ts) and nothing breaks, but nobody is told.
#
# What it alerts on (see docs/security/RESILIENCE_RUNBOOK.md §4.2):
#   payment.reconciliation_failed  — iKhokha took the money, we could not
#                                    record it. The one this app most needed.
#   payment.gateway_unreachable    — cannot confirm whether a payment cleared
#   ratelimit.degraded             — Redis is down, so password reset and admin
#                                    recovery are failing CLOSED for real users
#   admin.recovery_used/_denied    — the backdoor was used, or is being guessed
#   security.untrusted_forwarded_host  — someone is attempting reset-link poisoning
#   security.untrusted_redirect_target — an admin_redirects row points off-site
#   audit.digest                   — the daily summary, when it has something
# Repeats of the same event inside 5 minutes are collapsed, so an attack pages
# once rather than a thousand times.
ALERT_WEBHOOK_URL=

# Emergency admin account recovery (POST /api/admin/recover-admin).
#
# BOTH variables must be set or the endpoint stays disabled (404), and the
# secret must be at least 32 characters — that minimum is enforced, not
# advised. The endpoint is rate limited to 5 attempts per hour per caller and
# audits every attempt to vd_audit_log.
#
# ADMIN_RECOVERY_EMAIL nominates the ONE account this endpoint may act on. It
# used to act on whatever address the request body carried, which meant every
# account on the platform. Set it to the address you need to recover.
#
# Send:
#   Authorization: Bearer <ADMIN_RECOVERY_SECRET>
#   {"email":"<ADMIN_RECOVERY_EMAIL>", "password":"<12+ characters>"}
#
# UNSET BOTH as soon as the account is recovered. This is a backdoor; it should
# not be configured in a steady state.
ADMIN_RECOVERY_SECRET=
ADMIN_RECOVERY_EMAIL=
