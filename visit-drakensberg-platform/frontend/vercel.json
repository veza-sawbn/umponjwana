{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/expire-pending-bookings",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/recompute-segments",
      "schedule": "30 3 * * *"
    }
  ]
}
