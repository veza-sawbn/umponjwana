# ============================================================
# Visit Drakensberg Platform — Environment Variables
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# --- JWT ---
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Upstash Redis ---
REDIS_URL=https://your-instance.upstash.io
REDIS_TOKEN=your-redis-token

# --- Resend (email) ---
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@visitdrakensberg.com

# --- App URLs ---
FRONTEND_URL=umponjwana.vercel.app
BACKEND_URL=https://visit-drakensberg.onrender.com
ENVIRONMENT=production

# --- iKhokha (card payments) — SERVER ONLY, never NEXT_PUBLIC_* ---
# Set on the frontend host (Vercel), not the backend. Read by
# frontend/lib/ikhokha.ts, which signs every request with the app key.
#
# GOING LIVE: IKHOKHA_MODE is what decides whether real money moves. It
# defaults to 'test' — anything other than the exact string 'live' is test —
# so a missing or misspelled value silently keeps taking pretend payments.
# iKhokha issues separate credentials per mode: switch the App ID/Key to the
# live pair at the same time, or live requests will be rejected.
IKHOKHA_MODE=test
IKHOKHA_APP_ID=your-app-id
IKHOKHA_APP_KEY=your-app-key
# Merchant entity the payment is raised against. Both fall back to the App ID
# when unset, which is a guess — set them explicitly before going live.
IKHOKHA_ENTITY_ID=
IKHOKHA_EXTERNAL_ENTITY_ID=

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=https://your-project.supabase.co/rest/v1/
# Absolute, with scheme. Every invoice link we email is built from this, and
# so is the callbackUrl iKhokha posts payment results to — a bare hostname or
# a stale value means payments complete at the gateway but never reconcile.
NEXT_PUBLIC_SITE_URL=https://umponjwana.vercel.app
