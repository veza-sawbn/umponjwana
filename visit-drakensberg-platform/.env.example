# ============================================================
# Visit Drakensberg Platform — Environment Variables
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# --- JWT ---
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Upstash Redis ---
REDIS_URL=https://your-instance.upstash.io
REDIS_TOKEN=your-redis-token

# --- Resend (email) ---
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@visitdrakensberg.com

# --- App URLs ---
# Must include the scheme and carry no trailing slash — it is matched against
# the browser's Origin header, which is always scheme://host[:port].
FRONTEND_URL=https://umponjwana.vercel.app
BACKEND_URL=https://visit-drakensberg.onrender.com
ENVIRONMENT=production

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The FastAPI backend, NOT the Supabase REST endpoint. /api/backend/* falls
# back to this value, and pointing it at Supabase would turn that proxy into a
# relay to PostgREST (audit finding M3 — the proxy now refuses a Supabase host
# outright, but the variable should still be right).
NEXT_PUBLIC_API_URL=https://visit-drakensberg.onrender.com
# The canonical public domain, never a *.vercel.app address: it is what every
# canonical tag, og:url, sitemap entry and robots.txt points search engines at.
# When it is a custom domain, the production deploy's own *.vercel.app alias
# 308s to it (next.config.mjs), and preview deploys are always noindexed.
NEXT_PUBLIC_SITE_URL=https://visitdrakensberg.com
# Search engine ownership by HTML tag (optional; DNS TXT verification needs
# neither). Only the content="…" token, not the whole <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
